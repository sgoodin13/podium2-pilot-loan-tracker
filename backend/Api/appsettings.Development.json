{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }

  // No ConnectionStrings block here, deliberately.
  //
  // LoanTracker_Stack_Rules.md [STACK_RULES] is unconditional: "Never commit
  // appsettings.Development.json secrets or a real connection string — use
  // `dotnet user-secrets` locally." An earlier build argued in a comment that
  // throwaway container credentials are not a secret; that argument may be right
  // on the merits, but overriding a named stack rule in a code comment is not a
  // decision Developer gets to make (Compliance finding F3).
  //
  // Set it once per machine, from backend/Api:
  //
  //   dotnet user-secrets set "ConnectionStrings:LoanTracker" \
  //     "Host=localhost;Port=5433;Database=loantracker_dev_20260919_pilot;Username=loantracker;Password=$POSTGRES_PASSWORD"
  //
  // POSTGRES_PASSWORD comes from the .env file you created from .env.example.
  // The database name is RUN-SCOPED rather than fixed, per CLAUDE.md Incremental
  // Session Patterns; the Development-only bootstrap in Program.cs creates it.
  //
  // Program.cs throws a named, actionable error if this is missing.
}
