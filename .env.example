# LoanTracker — local development credentials.
#
# Copy to `.env` (which is gitignored) before the first `docker compose up`:
#
#   cp .env.example .env
#
# Then pick a password and set the matching connection string for the API, from
# backend/Api:
#
#   dotnet user-secrets set "ConnectionStrings:LoanTracker" \
#     "Host=localhost;Port=5433;Database=loantracker_dev_20260919_pilot;Username=loantracker;Password=<the password below>"
#
# These are throwaway credentials for a container on your own machine, but they
# live here rather than in a committed file because LoanTracker_Stack_Rules.md
# [STACK_RULES] does not carve out an exception for throwaway ones.

POSTGRES_USER=loantracker
POSTGRES_PASSWORD=change-me-locally
